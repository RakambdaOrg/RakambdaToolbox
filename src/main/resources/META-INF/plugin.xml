<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>fr.rakambda.rakambdatoolbox</id>
    <name>Rakambda Toolbox</name>
    <vendor url="https://github.com/RakambdaOrg">Rakambda</vendor>
    <description><![CDATA[
        Custom plugin for various personal tasks
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- Terminal title notifier: settings, notifications and Classic terminals -->
    <depends optional="true" config-file="rakambdatoolbox-terminal.xml">org.jetbrains.plugins.terminal</depends>

    <content>
        <!-- Terminal title notifier: Reworked terminals (needs the intellij.terminal.frontend module) -->
        <module name="fr.rakambda.rakambdatoolbox.terminal.reworked"/>
    </content>

    <resource-bundle>messages.RakambdaToolboxBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
    </extensions>
</idea-plugin>
